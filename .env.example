# Copy to .env if desired. Compose also accepts exported shell variables.
HOOKROUTY_IMAGE=hookrouty:local
APP_SECRET_KEY=REPLACE_WITH_BASE64_ENCODED_32_RANDOM_BYTES
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
APP_URL=http://localhost:8080
# Set to 0.0.0.0 if this port must be reachable from other hosts.
HOOKROUTY_BIND_ADDRESS=127.0.0.1
